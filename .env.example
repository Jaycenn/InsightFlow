# Copy to .env for local development. Replace both placeholder values.
POSTGRES_PASSWORD=replace-with-local-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DATABASE_URL=postgresql+psycopg://insightflow:replace-with-local-password@localhost:5432/insightflow
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5
